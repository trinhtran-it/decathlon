# Java / Spring Boot (RetailStockUnited)
**/target/
!**/target/classes/application.properties
!**/target/classes/db/seed/
**/.apt_generated/
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/.sts4-cache
**/bin/
**/!**/src/main/**/bin/
**/!**/src/test/**/bin/

# JetBrains IDEs
**/.idea/
**/*.iws
**/*.iml
**/*.ipr

# VS Code
**/.vscode/*
**/!.vscode/settings.json
**/!.vscode/tasks.json
**/!.vscode/launch.json
**/!.vscode/extensions.json

# Docker
**/.env.docker
**/docker-compose.override.yml
**/.docker/data/
**/volumes/
**/docker-volumes/

# Keep dependency lock files for reproducible builds
# But ignore Yarn 1.x's ignored files
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Database files
**/*.sqlite
**/*.db
**/*.db-journal

# Compiled Java class files
**/*.class

# Maven
**/.mvn/timing.properties
**/.mvn/wrapper/maven-wrapper.jar

# Local database dumps and backups
**/*.dump
**/*.bak
**/*.sql.gz
**/*.backup
**/*.sql.bz2

# Code coverage reports
**/coverage-report/
**/.coverage
**/htmlcov/
**/coverage/
**/.scannerwork/

# Generated documentation
**/site/
**/_site/
**/docs-build/

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Development environment
**/.env.development
**/.env.test

# Build artifacts
**/build/
**/.build/
**/dist/
**/out/

# Temporary files
**/tmp/
**/temp/
**/.tmp/
**/*.tmp
**/*.bak
**/*.swp
**/*~

# System-specific artifacts
**/.directory
**/.fuse_hidden*
**/.Trash-*
**/.nfs*
