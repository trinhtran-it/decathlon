# Local development secrets for docker-compose.
#
#   cp .env.example .env    # then replace every "change-me" value
#
# .env is git-ignored. Never commit real credentials.
# docker-compose refuses to start if any of these are unset.
#
# Note: the databases are initialised with these credentials on first start only.
# After changing them, reset the volumes with `docker-compose down -v`.

# MongoDB (RetailProductVietnam product data)
# Used inside a connection URI, so URL-encode any special characters.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-mongo-password

# PostgreSQL (RetailStockUnited stock data)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# Shared API key: RetailProductVietnam -> RetailStockUnited (X-API-KEY header)
# Generate one with: openssl rand -hex 32
RETAIL_STOCK_UNITED_API_KEY=change-me-api-key
